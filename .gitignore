# ---------- Capacitor / Mobile ----------
# Keep config + manifest, ignore generated build artefacts.
# (ClientApp now lives under server/src/Artha.Api/.)
**/ClientApp/ios/App/Pods/
**/ClientApp/ios/App/App.xcworkspace/xcuserdata/
**/ClientApp/ios/App/build/
**/ClientApp/ios/DerivedData/
**/ClientApp/android/.gradle/
**/ClientApp/android/build/
**/ClientApp/android/app/build/
**/ClientApp/android/local.properties
**/ClientApp/android/captures/
**/ClientApp/android/.idea/

# Published artefacts the .NET build copies into wwwroot from ClientApp/dist
server/src/Artha.Api/wwwroot/

