<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>artha-api-dev</UserSecretsId>
    <SpaRoot>ClientApp\</SpaRoot>
    <SpaProxyServerUrl>http://localhost:4200</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>npm start</SpaProxyLaunchCommand>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Artha.Core\Artha.Core.csproj" />
    <ProjectReference Include="..\Artha.Auth\Artha.Auth.csproj" />
    <ProjectReference Include="..\Artha.Drive\Artha.Drive.csproj" />
    <ProjectReference Include="..\Artha.Infrastructure\Artha.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    Keep the SPA source tree out of the .NET compile/publish item set EXCEPT for
    the published wwwroot files we copy in below.
  -->
  <ItemGroup>
    <Content Remove="$(SpaRoot)**" />
    <None Remove="$(SpaRoot)**" />
    <None Include="$(SpaRoot)**" Exclude="$(SpaRoot)node_modules\**;$(SpaRoot)dist\**;$(SpaRoot).angular\**;$(SpaRoot)android\**;$(SpaRoot)ios\**" />
  </ItemGroup>

  <!--
    On `dotnet publish`, build the Angular app in production mode and copy its
    output into wwwroot so the .NET process serves it as static files.
    Skipped during plain `dotnet build` / `dotnet test` for fast iteration.
  -->
  <Target Name="PublishSpa" AfterTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm --version" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" Condition="!Exists('$(SpaRoot)node_modules')" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build -- --configuration=production" />

    <ItemGroup>
      <SpaDist Include="$(SpaRoot)dist\client\browser\**" />
      <ResolvedFileToPublish Include="@(SpaDist->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
