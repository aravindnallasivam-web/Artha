<?xml version="1.0" encoding="utf-8"?>
<!-- SmsPromptActivity layout — rendered over the lock screen / other apps when a
     bank-SMS expense is detected. Top: brand. Middle: amount, merchant and what
     Artha knows. When the category or account isn't learned yet, chip pickers
     appear under it so the user can choose one right here. Bottom: a primary
     pill (Add / Open Artha to review), an outlined Dismiss pill and an
     "Open Artha to edit" link. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/prompt_background"
    android:fitsSystemWindows="true">

    <!-- Brand + "Expense detected" eyebrow -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="40dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/app_name"
            android:textColor="@color/prompt_text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:text="@string/prompt_title"
        android:textColor="@color/prompt_text_muted"
        android:textSize="13sp"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:fontFamily="sans-serif-medium" />

    <!-- "1 of 3" when several SMS are waiting; Add / Dismiss move to the next. -->
    <TextView
        android:id="@+id/prompt_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/prompt_btn_outline"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@color/prompt_text"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone" />

    <View
        android:id="@+id/prompt_spacer_top"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Amount + merchant + what's known -->
    <TextView
        android:id="@+id/prompt_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="₹0"
        android:textColor="@color/prompt_text"
        android:textSize="64sp"
        android:fontFamily="sans-serif"
        android:letterSpacing="-0.03"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/prompt_merchant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:textColor="@color/prompt_text"
        android:textSize="17sp"
        android:fontFamily="sans-serif-medium"
        android:textAlignment="center"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/prompt_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:textColor="@color/prompt_text_muted"
        android:textSize="14sp"
        android:textAlignment="center"
        android:fontFamily="sans-serif" />

    <View
        android:id="@+id/prompt_spacer_bottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Pick the category / account here when Artha doesn't know them yet.
         Shown (and given the spare height) by SmsPromptActivity. -->
    <ScrollView
        android:id="@+id/prompt_pickers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0"
        android:layout_marginTop="20dp"
        android:fadingEdgeLength="24dp"
        android:requiresFadingEdge="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- Nearby shops (location), when the SMS doesn't name the shop. -->
            <TextView
                android:id="@+id/prompt_nearby_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:textColor="@color/prompt_text_muted"
                android:textSize="12sp"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone" />

            <com.artha.app.FlowLayout
                android:id="@+id/prompt_nearby_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:visibility="gone" />

            <!-- "Asking AI…" / "AI picked" while the provider suggests a category / account. -->
            <TextView
                android:id="@+id/prompt_ai_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/prompt_btn_outline"
                android:textColor="@color/prompt_text"
                android:textSize="12.5sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone" />

            <TextView
                android:id="@+id/prompt_category_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:text="Pick a category"
                android:textColor="@color/prompt_text_muted"
                android:textSize="12sp"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:fontFamily="sans-serif-medium" />

            <com.artha.app.FlowLayout
                android:id="@+id/prompt_category_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Subcategories of the tapped group (optional), shown under its chips. -->
            <TextView
                android:id="@+id/prompt_sub_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:textColor="@color/prompt_text_muted"
                android:textSize="12sp"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone" />

            <com.artha.app.FlowLayout
                android:id="@+id/prompt_sub_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/prompt_account_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="Paid from"
                android:textColor="@color/prompt_text_muted"
                android:textSize="12sp"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:fontFamily="sans-serif-medium" />

            <com.artha.app.FlowLayout
                android:id="@+id/prompt_account_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Actions -->
    <LinearLayout
        android:id="@+id/prompt_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="16dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/prompt_primary_btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center"
            android:background="@drawable/prompt_btn_pill"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/prompt_approve"
            android:textColor="@color/prompt_text"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />

        <TextView
            android:id="@+id/prompt_secondary_btn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:background="@drawable/prompt_btn_outline"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/prompt_dismiss"
            android:textColor="@color/prompt_text"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/prompt_open_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/prompt_open"
            android:textColor="@color/prompt_text_muted"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>
</LinearLayout>
