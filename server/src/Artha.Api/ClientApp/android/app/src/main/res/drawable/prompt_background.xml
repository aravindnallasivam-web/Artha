<?xml version="1.0" encoding="utf-8"?>
<!-- Two-stop vertical gradient painted behind the lock-screen takeover.
     Matches the HTML mockup's indigo-into-slate wallpaper so the native
     screen reads as the same brand as the WebView. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="@color/prompt_bg_bot"
        android:centerColor="@color/prompt_bg_mid"
        android:endColor="@color/prompt_bg_top" />
</shape>
