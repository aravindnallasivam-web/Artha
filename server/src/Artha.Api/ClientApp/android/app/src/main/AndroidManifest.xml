<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Read & receive SMS so Artha can detect bank transaction messages and
         offer to log them as expenses. Android-only; parsing happens entirely
         on-device. These are sensitive permissions and are only requested
         after the user explicitly enables SMS capture in Settings. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Send a balance-enquiry SMS to the bank when the user taps "Sync balance". -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Read the active SIMs so the user can pick which one sends the
         balance-enquiry SMS on a dual-SIM phone. Requested on demand. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Post a notification when a bank SMS arrives while the app is closed. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Elevate the SMS-detected expense notification to a lock-screen takeover
         (like an incoming call). On Android 14+ the OS also requires the user
         to manually grant this in Settings → App → Full-screen notifications
         or the alert quietly degrades to a heads-up banner. The in-app Settings
         toggle links out to that screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                OAuth deep link (serverless): the Android OAuth client redirects
                to the reversed-client-id custom scheme
                com.googleusercontent.apps.<client-id>:/oauth2redirect?code=...
                which this filter routes back into the app. The legacy
                com.artha.app scheme is kept for any other deep links.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.googleusercontent.apps.952436597649-6bpd2mli17eg30falj66bqpt8p5svvso" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.artha.app" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Fires even when the app is killed; posts a notification for bank
             debit SMS so the user can open Artha and confirm. Guarded by
             BROADCAST_SMS so only the system can deliver it. -->
        <receiver
            android:name=".SmsBackgroundReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Backs the Dismiss action button on the expense-detected notification.
             Silent: cancels the notification without launching the app. Not
             exported — only our own PendingIntent targets it. -->
        <receiver
            android:name=".SmsActionReceiver"
            android:exported="false" />

        <!-- Lock-screen takeover for a bank-SMS expense. Launched by the
             background receiver's full-screen intent and renders above the
             keyguard without unlocking (MyGate / NoBroker visitor-approval
             pattern). singleInstance + excludeFromRecents + noHistory so it
             never piles up or appears in Recents — it's a modal, not a page. -->
        <activity
            android:name=".SmsPromptActivity"
            android:theme="@style/AppTheme.SmsPrompt"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
