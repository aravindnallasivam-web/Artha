# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real secrets.
#
# These three values are read by scripts/deploy-do.sh when it provisions the
# DigitalOcean App Platform app from .do/app.yaml.

# Google OAuth Web client SECRET from https://console.cloud.google.com/apis/credentials
# (The Client ID is already in .do/app.yaml — it's public and safe to commit.)
GOOGLE_CLIENT_SECRET=

# Random 32+ char string used to sign Artha session JWTs.
# Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=

# Optional — defaults to "artha" if not set. Becomes part of the *.ondigitalocean.app URL.
DO_APP_NAME=artha

# Optional — DO region slug. Common: nyc, sfo, blr, fra, ams, lon, sgp, tor, syd.
DO_REGION=nyc
